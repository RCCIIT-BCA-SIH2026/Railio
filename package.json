{
  "name": "railio-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File ./scripts/start-dev.ps1",
    "dev:ai": "cd ai-service && python -m uvicorn app.main:app --port 8000 --reload",
    "start": "cd ai-service && uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-10000}",
    "build": "npm --prefix admin-web run build && npm --prefix backend run build",
    "build:admin": "npm --prefix admin-web run build",
    "build:backend": "npm --prefix backend run build",
    "dev:admin": "npm --prefix admin-web run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:mobile": "npm --prefix mobile run start",
    "start:backend": "npm --prefix backend run start"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.48.1"
  }
}
